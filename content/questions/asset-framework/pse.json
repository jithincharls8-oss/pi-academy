  {
    "id": "q-pse-sandbox",
    "type": "mcq",
    "domain": "asset-framework",
    "coverage": [
      "af.pse"
    ],
    "difficulty": 1,
    "prompt": "True or false: edits you make in PSE are visible to other users as soon as you type them.",
    "options": [
      {
        "id": "t",
        "text": "True"
      },
      {
        "id": "f",
        "text": "False"
      }
    ],
    "answer": "f",
    "explanation": "False. \"The AF Server uses a sandbox concept for modifications.\" Changes are visible to others only after Check In, and checked-out objects cannot be edited by others until then.",
    "lessonId": "pi-system-explorer",
    "tags": [
      "true-false"
    ],
    "sources": [
      "af-building-assets-workbook"
    ]
  },
