  {
    "id": "q-pse-export",
    "type": "scenario",
    "domain": "asset-framework",
    "coverage": [
      "af.pse"
    ],
    "difficulty": 2,
    "prompt": "What went wrong?",
    "scenario": "An engineer exports one element to XML from the test server and imports it on production. The import fails because templates and tables it needs are missing.",
    "options": [
      {
        "id": "a",
        "text": "The export was not done in Excel"
      },
      {
        "id": "b",
        "text": "The export was made without Include All Referenced Objects"
      },
      {
        "id": "c",
        "text": "XML import is not supported between servers"
      },
      {
        "id": "d",
        "text": "Production uses a different SQL edition"
      }
    ],
    "answer": "b",
    "explanation": "Include All Referenced Objects also exports the templates, tables and UOMs needed to rebuild the structure. Without it, the target server lacks dependencies.",
    "lessonId": "pi-system-explorer",
    "tags": [
      "pitfall"
    ],
    "sources": [
      "af-building-assets-workbook"
    ]
  },
