[
  {
    "id": "af-convert",
    "name": "Convert",
    "kind": "af",
    "category": "Conversion / UOM",
    "signature": "Convert(expr, \"uom\")",
    "description": "Converts or assigns a unit of measure to an expression result before it is written to the output.",
    "params": [
      {
        "name": "expr",
        "description": "expression"
      },
      {
        "name": "uom",
        "description": "unit abbreviation in double quotes"
      }
    ],
    "returns": "Number with a UOM",
    "example": "Convert(Curve('Adjusted Wind Speed', (0,0) (3.99,0) (4,78) (5,193) (25,3000) (25.01,0) (100,0)),\"kW\")",
    "sources": [
      "fn-using-af-analyze-2019",
      "fn-calc-asset-analytics-2022",
      "af-using-af-analyze-asset-2019"
    ],
    "verify": false
  },
